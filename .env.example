# AI
GEMINI_API_KEY=your_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=mistralai/mistral-small-4-119b-2603
NVIDIA_TIMEOUT_SECONDS=60
NVIDIA_PLAN_TIMEOUT_SECONDS=180
NVIDIA_MAX_TOKENS_PLAN=1200
OUTPUT_ANALYSIS_PROVIDER=nvidia
OUTPUT_ANALYSIS_MODEL=nvidia/nemotron-3-super-120b-a12b
OUTPUT_ANALYSIS_TIMEOUT_SECONDS=90
OUTPUT_ANALYSIS_REASONING_BUDGET=4096
# Optional per-model NVIDIA keys derived from the model name
# NVIDIA_API_KEY_MISTRALAI_MISTRAL_SMALL_4_119B_2603=nvapi-...
# NVIDIA_API_KEY_META_LLAMA_3_1_70B_INSTRUCT=nvapi-...
# Django
DJANGO_SECRET_KEY=replace_me
DJANGO_DEBUG=true
